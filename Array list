import java.util.HashSet;

public class Illustrate {
    public static void main(String[] args) {
        
        HashSet<String> tags = new HashSet<>();
        
        tags.add("kishor");
        tags.add("rohith");
        tags.add("rishab");
        
        for (String tag : tags) {
            System.out.println(tag);
        }
    }
}
